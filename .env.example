# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
DEV_DATABASE_URL=sqlite:///instance/amc_website_dev.db
DATABASE_URL=sqlite:///instance/amc_website.db

# Email Configuration (Development - Console)
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@arlingtonmenscircle.com

# AWS Configuration (for future SES/S3 integration)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Application Configuration
AMC_ADMIN_EMAIL=admin@arlingtonmenscircle.com
